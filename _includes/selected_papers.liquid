<div class="publications">
  <h2>preprints</h2>

  {% bibliography -f papers -q @*[selected=true && status=preprint] --sort_by year,month --order descending,descending %}

  {% comment %}
    <h2>publications</h2>

    {% bibliography -f papers -q @*[selected=true && status!=preprint] --group_by year --group_order descending --sort_by year,month --order descending,descending %}
  {% endcomment %}
</div>
